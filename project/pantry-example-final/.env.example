# Copy to .env (cp .env.example .env). Compose reads it from this folder.
# Every setting the system needs, with safe placeholder values for a laptop.
# A deployed copy uses its own, secret values -- never these.

# The port the app is served on: http://localhost:5181
WEB_PORT=5181

# MySQL. The `app` service reads the same names.
DB_DATABASE=pantry
DB_USERNAME=pantry
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
