# Copy to .env (cp .env.example .env). Compose reads .env from this folder.
# Every setting the system needs, with safe placeholder values.

# The port the prototype is served on, on your laptop: http://localhost:5181
# Change it if something else already uses 5181.
WEB_PORT=5181

